<?xml version="1.0" encoding="utf-8"?>
<!-- 小说下载页：与漫画下载页同构（标题栏 + 卷列表 + 底部操作条），只是没有隐藏 WebView -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCFCFF">

    <include
        android:id="@+id/ntitle"
        layout="@layout/widget_titlebar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/nlazys"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FCFCFF"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/nbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ntitle">

        <LinearLayout
            android:id="@+id/nvols"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/nbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FCFCFF"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/nstatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/nall"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/ndl_select_all"
                android:textSize="13sp" />

            <Button
                android:id="@+id/nseldl"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1.3"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/ndl_download_selected"
                android:textSize="13sp" />

            <Button
                android:id="@+id/ndel"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1.2"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/ndl_delete_selected"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
